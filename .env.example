# Скопируйте в .env. Секреты никогда не загружайте в GitHub.
HOST=127.0.0.1
PORT=8000
# Для QR со смартфона укажите адрес компьютера в локальной сети.
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=0
# Необязательное распознавание фото через OpenAI-совместимый API.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
# Уведомления по умолчанию только записываются в журнал.
NOTIFICATIONS_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
